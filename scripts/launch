#!/bin/sh
set -u
command=${LINKPAD_CLIENT:-/usr/bin/steamlink}
base=$(dirname "$(readlink -f "$0")")
temporary_runtime=0
if [ -n "${LINKPAD_RUNTIME_DIR:-}" ]; then
    runtime=$LINKPAD_RUNTIME_DIR
else
    runtime=$(mktemp -d "${TMPDIR:-/tmp}/linkpad.XXXXXX") || exit 1
    temporary_runtime=1
    trap 'rm -rf "$runtime"' EXIT
fi
if [ -e /etc/linkpad.disabled ] || [ -e "$runtime/disabled" ] ||
   [ ! -r "$base/bootstrap.so" ] || [ ! -r "$base/native.so" ]; then
    if [ "$temporary_runtime" -eq 1 ]; then rm -rf "$runtime"; trap - EXIT; fi
    exec "$command" "$@"
fi
export LINKPAD_ORIGINAL_LD_PRELOAD=${LD_PRELOAD-}
export LINKPAD_ORIGINAL_LD_LIBRARY_PATH=${LD_LIBRARY_PATH-}
export LINKPAD_ORIGINAL_QT_PLUGIN_PATH=${QT_PLUGIN_PATH-}
export LINKPAD_ORIGINAL_QT_QPA_PLATFORM=${QT_QPA_PLATFORM-}
export LINKPAD_ORIGINAL_PATH=${PATH-}
export LINKPAD_ORIGINAL_TMPDIR=${TMPDIR-}
export LINKPAD_MODULE="$base/native.so"
export LD_PRELOAD="$base/bootstrap.so${LD_PRELOAD:+:$LD_PRELOAD}"
"$command" "$@"
result=$?
unset LD_PRELOAD LINKPAD_MODULE
if [ "$result" -ne 0 ]; then
    : > "$runtime/disabled"
    logger -t linkpad "Client exited with status $result; extension disabled for subsequent launches in this runtime directory"
fi
exit "$result"
