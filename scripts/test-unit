#!/bin/sh
# Tests that need neither Qt nor Steam Link; they also run on a development machine.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
: "${OUT_DIR:=$root/out}"
: "${CXX:=g++}"
json=$("$root/scripts/json-include")
mkdir -p "$OUT_DIR"
"$CXX" -O2 -std=c++17 "$root/tests/command-target.cpp" -o "$OUT_DIR/command-target"
for test in config chord; do
    "$CXX" -O2 -Wall -Wextra -Werror -std=c++17 -I"$root/src" -isystem "$json" \
        "$root/tests/test-$test.cpp" -o "$OUT_DIR/test-$test"
    "$OUT_DIR/test-$test"
done
"$root/tests/test-packaging.sh"
