#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
: "${STEAMLINK_DIR:=${XDG_DATA_HOME:-$HOME/.local/share}/SteamLink}"
: "${OUT_DIR:=$root/out}"
export LD_LIBRARY_PATH="$STEAMLINK_DIR/lib:$STEAMLINK_DIR/Qt-5.14.1/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_QPA_PLATFORM=offscreen QT_PLUGIN_PATH="$STEAMLINK_DIR/Qt-5.14.1/plugins"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
STEAMLINK_TOOL_CONFIG="$stage/shortcuts.json" STEAMLINK_SHORTCUT_SOCKET="$stage/state.sock" STEAMLINK_TOOL_MODULE="$OUT_DIR/native-test.so" LD_PRELOAD="$OUT_DIR/bootstrap.so" timeout 40s "$OUT_DIR/test-input"
