#!/bin/sh
# Print the include directory containing nlohmann/json.hpp.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${JSON_HEADERS:-}" ]; then
    if [ -f "$JSON_HEADERS/nlohmann/json.hpp" ]; then
        echo "$JSON_HEADERS"
        exit 0
    fi
    echo "JSON_HEADERS=$JSON_HEADERS does not contain nlohmann/json.hpp." >&2
    exit 1
fi
for path in "$root/.cache/json-headers/usr/include" /usr/include; do
    if [ -f "$path/nlohmann/json.hpp" ]; then
        echo "$path"
        exit 0
    fi
done
echo 'nlohmann/json headers missing. Run make headers (or make headers-json), or set JSON_HEADERS.' >&2
exit 1
