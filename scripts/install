#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
: "${PREFIX:=/usr/local}"
: "${DESTDIR:=}"
: "${OUT_DIR:=$root/out}"
case "$PREFIX" in /*) ;; *) echo 'PREFIX must be absolute' >&2; exit 1;; esac
case "/$PREFIX/" in */../*) echo 'PREFIX must not contain parent traversal' >&2; exit 1;; esac
if [ -n "$DESTDIR" ]; then
    case "$DESTDIR" in /*) ;; *) echo 'DESTDIR must be absolute' >&2; exit 1;; esac
    case "/$DESTDIR/" in */../*) echo 'DESTDIR must not contain parent traversal' >&2; exit 1;; esac
    destination=$(realpath -m "$DESTDIR")
    for path in "$DESTDIR$PREFIX/lib/linkpad" "$DESTDIR$PREFIX/bin"; do
        case "$(realpath -m "$path")/" in "$destination/"*) ;; *) echo 'Destination symlink escapes DESTDIR' >&2; exit 1;; esac
    done
fi
lib="$DESTDIR$PREFIX/lib/linkpad"
bin="$DESTDIR$PREFIX/bin/linkpad"
marker="$lib/.installed-by-linkpad"
link=../lib/linkpad/launch
case "${1:-install}" in
install)
    for file in bootstrap.so native.so; do
        test -f "$OUT_DIR/$file" || { echo "Missing $OUT_DIR/$file; run make build first" >&2; exit 1; }
    done
    if [ -e "$bin" ] || [ -L "$bin" ]; then
        test -L "$bin" && test "$(readlink "$bin")" = "$link" || { echo "Refusing to replace $bin" >&2; exit 1; }
    fi
    if [ -e "$lib" ] && [ ! -f "$marker" ]; then
        echo "Refusing to replace unmanaged directory $lib" >&2; exit 1
    fi
    install -d "$lib" "$(dirname "$bin")"
    for file in bootstrap.so native.so; do
        install -m 0755 "$OUT_DIR/$file" "$lib/$file.new"
        mv -f "$lib/$file.new" "$lib/$file"
    done
    install -m 0755 "$root/scripts/launch" "$lib/launch.new"
    mv -f "$lib/launch.new" "$lib/launch"
    : > "$marker"
    ln -sfn "$link" "$bin"
    echo 'Installed tool libraries and launcher. No system configuration changed.'
    ;;
uninstall)
    test -f "$marker" || { echo 'No tool installation marker found' >&2; exit 1; }
    if [ -L "$bin" ] && [ "$(readlink "$bin")" = "$link" ]; then rm "$bin"; fi
    rm -f "$lib/bootstrap.so" "$lib/native.so" "$lib/launch" "$marker"
    rmdir "$lib" 2>/dev/null || :
    echo 'Uninstalled tool files. User configuration preserved.'
    ;;
*) echo 'Usage: scripts/install [install|uninstall]' >&2; exit 1;;
esac
