#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
: "${STEAMLINK_DIR:=${XDG_DATA_HOME:-$HOME/.local/share}/SteamLink}"
: "${OUT_DIR:=$root/out}"
"$root/scripts/test-unit"
export LD_LIBRARY_PATH="$STEAMLINK_DIR/lib:$STEAMLINK_DIR/Qt-5.14.1/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_QPA_PLATFORM=offscreen
export QT_PLUGIN_PATH="$STEAMLINK_DIR/Qt-5.14.1/plugins"
"$OUT_DIR/test-home"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
STEAMLINK_PROBE_MODULE="$OUT_DIR/native.so" STEAMLINK_SHORTCUT_SOCKET="$stage/state.sock" LD_PRELOAD="$OUT_DIR/bootstrap.so" timeout 10s "$OUT_DIR/test-lifecycle"
